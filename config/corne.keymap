#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        macro_nye: macro_nye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_a_acc: macro_a_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_e_acc: macro_e_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N3 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_i_acc: macro_i_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_o_acc: macro_o_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_u_acc: macro_u_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_ques: macro_ques {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_excl: macro_excl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N7 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL      &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LS(LSHFT)  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                             &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6        &kp N7          &kp N8    &kp N9     &kp N0        &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT      &kp DOWN        &kp UP    &kp RIGHT  &kp SQT       &kp RA(N)
&kp LSHFT   &kp LC(C)     &kp LC(V)     &kp LC(X)     &kp LC(Z)     &trans          &msc SCRL_UP  &msc SCRL_DOWN  &trans    &trans     &kp QUESTION  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET       &trans          &kp RALT
            >;
        };

        layer_two {
            bindings = <
&kp TAB         &kp EXCLAMATION  &kp AT_SIGN       &kp POUND       &kp DOLLAR  &kp PERCENT     &kp CARET  &kp AMPS       &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&kp LCTRL       &kp UNDERSCORE   &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp COLON   &kp LT          &kp GT     &kp SEMICOLON  &kp RIGHT_BRACE  &kp RIGHT_BRACKET     &kp EQUAL              &kp SQT
&kp LEFT_SHIFT  &kp BACKSLASH    &kp PIPE          &kp TILDE       &kp COMMA   &kp QUESTION    &kp PLUS   &kp MINUS      &kp ASTERISK     &kp SLASH             &kp PERIOD             &kp DOUBLE_QUOTES
                                                   &trans          &trans      &trans          &trans     &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&kp F1  &kp F2      &kp F3           &kp F4        &kp F5            &kp F6    &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
&trans  &kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOL_DN  &kp C_PLAY_PAUSE  &trans    &macro_a_acc  &macro_e_acc  &macro_i_acc  &macro_o_acc  &macro_u_acc  &trans
&trans  &trans      &trans           &trans        &trans            &trans    &macro_nye    &macro_ques   &macro_excl   &trans        &trans        &trans
                                     &trans        &trans            &trans    &trans        &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cap3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
